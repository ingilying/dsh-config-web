{
  "name": "dsh-config-web",
  "version": "0.1.0",
  "description": "Configurable HTTP(S) fetch provider for DeepSeek Harness with optional private network support",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-fetch",
    "ssrf",
    "ipaddr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingilying/dsh-config-web.git"
  },
  "homepage": "https://github.com/ingilying/dsh-config-web#readme",
  "bugs": {
    "url": "https://github.com/ingilying/dsh-config-web/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "install.sh"
  ],
  "bin": {
    "dsh-config-web": "./bin/install.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.6.0",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-timeout": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/dsh-web-fetch-http": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-timeout": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-web": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-web-fetch-http": "^0.1.7-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^26.6.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
